# Copy to .env and adjust.
NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=learning_platform

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# rounds for bcrypt
BCRYPT_ROUNDS=10

# Judge engine (Piston) — isolated container, never runs code in this process
JUDGE_URL=http://127.0.0.1:2000
JUDGE_RUN_TIMEOUT_MS=8000
JUDGE_COMPILE_TIMEOUT_MS=10000

# CORS: comma-separated allowed origins for the SPA
CORS_ORIGINS=http://localhost:5173

# Seed script defaults
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_STUDENT_PASSWORD=student123
