# Copy to .env and adjust.
NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=learning_platform

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# rounds for bcrypt
BCRYPT_ROUNDS=10

# Google Sign-In for students (Google Cloud Console -> Credentials -> OAuth client
# -> Web application; add http://localhost:5173 as an authorised JavaScript origin).
# When GOOGLE_CLIENT_ID is empty the login screen falls back to email + password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "false" to hide the student email/password form once Google is live
# (the endpoint stays available for seeded demo accounts and testing).
ALLOW_PASSWORD_LOGIN=true

# AI question author — describe a question, get a statement + verified test cases.
# Defaults to a LOCAL model via Ollama (no API key). Install Ollama, then:
#   ollama pull qwen2.5-coder:7b   &&   ollama serve
AI_API_STYLE=ollama                       # ollama | openai
AI_BASE_URL=http://localhost:11434        # openai style: e.g. https://api.groq.com/openai
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=                               # only for AI_API_STYLE=openai
AI_TIMEOUT_MS=120000

# Judge engine (Piston) — isolated container, never runs code in this process
JUDGE_URL=http://127.0.0.1:2000
JUDGE_RUN_TIMEOUT_MS=8000
JUDGE_COMPILE_TIMEOUT_MS=10000

# CORS: comma-separated allowed origins for the SPA
CORS_ORIGINS=http://localhost:5173

# Seed script defaults
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_STUDENT_PASSWORD=student123
